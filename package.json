{
  "name": "dsh-session-manager",
  "version": "0.5.3",
  "description": "DSH Web 会话管理：删除、归档、跨工作区移动、迁移预设；收藏、待看、搜索、排序、设置优先级，添加标签和备注；批量处理。欢迎至 GitHub 提意见。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "archive",
    "move",
    "workspace",
    "preset",
    "migration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkkz9522/dsh-session-manager.git"
  },
  "bugs": {
    "url": "https://github.com/hkkz9522/dsh-session-manager/issues"
  },
  "homepage": "https://github.com/hkkz9522/dsh-session-manager",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "scripts/heal-v2-sessions.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/session-files.js && node --check lib/annotation-store.js && node --check lib/clipboard-parser.js && node -e \"import('./lib/index.js')\"",
    "test": "node scripts/run-tests.mjs",
    "check:package": "node scripts/check-package.mjs"
  }
}
