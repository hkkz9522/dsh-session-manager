{
  "name": "dsh-session-manager",
  "version": "0.1.0",
  "description": "会话管理器：删除对话（删除前二次确认）+ 归档管理（移入/移出归档），Web UI 全面接管侧边栏会话列表与头部操作",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "archive"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hkkz9522/dsh-session-manager.git"
  },
  "bugs": {
    "url": "https://github.com/hkkz9522/dsh-session-manager/issues"
  },
  "homepage": "https://github.com/hkkz9522/dsh-session-manager",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  }
}
