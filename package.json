{
  "name": "dsh-session-manager",
  "version": "0.7.2",
  "description": "DeepSeek Harness session and workspace manager —— Workspaces: archive and visibility. Sessions: move, migrate presets, delete, favorite, review later, prioritize, tag, and annotate. Batch operations. | DSH 会话与工作区管理——工作区：归档与显示。会话：跨工作区移动、预设迁移、删除；收藏、待回看、优先级、标签、备注。批量操作。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "plugin",
    "session",
    "session-manager",
    "session-management",
    "archive",
    "move",
    "workspace",
    "workspace-archive",
    "workspace-management",
    "preset",
    "agent-preset",
    "migration",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkkz9522/dsh-session-manager.git"
  },
  "bugs": {
    "url": "https://github.com/hkkz9522/dsh-session-manager/issues"
  },
  "homepage": "https://github.com/hkkz9522/dsh-session-manager",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "scripts/heal-v2-sessions.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/session-files.js && node --check lib/annotation-store.js && node --check lib/workspace-archive-store.js && node --check lib/clipboard-parser.js && node -e \"import('./lib/index.js')\"",
    "test": "node scripts/run-tests.mjs",
    "check:package": "node scripts/check-package.mjs"
  }
}
